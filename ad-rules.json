{
  "schemaVersion": 1,
  "version": "2026.11.19.2",
  "rules": [
    {
      "id": "foch83",
      "domains": [
        "foch83.com",
        "*.foch83.com"
      ],
      "enabled": true,
      "actions": [
        {
          "type": "click",
          "kind": "skip",
          "selector": "button, [role='button']",
          "text": "ข้ามโฆษณา",
          "exact": false
        },
        {
          "type": "click",
          "kind": "skip",
          "selector": "button, [role='button']",
          "text": "Skip Ad",
          "exact": false
        },
        {
          "type": "click",
          "kind": "close",
          "selector": "button[aria-label='ปิดโฆษณา']",
          "text": "ปิดโฆษณา",
          "exact": false
        },
        {
          "type": "click",
          "kind": "close",
          "selector": "button[aria-label='Close advertisements']",
          "text": "Close advertisements",
          "exact": false
        },
        {
          "type": "hide",
          "selector": "a[href*='ibit.ly/']"
        },
        {
          "type": "hide",
          "selector": "a[href*='cutt.ly/']"
        },
        {
          "type": "hide",
          "selector": "a[href*='ambking99.wtf/']"
        }
      ]
    }
  ]
}
